FROM ghcr.io/railwayapp/nixpacks:ubuntu-1745885067

ENTRYPOINT ["/bin/bash", "-l", "-c"]
WORKDIR /app/


COPY .nixpacks/nixpkgs-23f9169c4ccce521379e602cc82ed873a1f1b52b.nix .nixpacks/nixpkgs-23f9169c4ccce521379e602cc82ed873a1f1b52b.nix
RUN nix-env -if .nixpacks/nixpkgs-23f9169c4ccce521379e602cc82ed873a1f1b52b.nix && nix-collect-garbage -d


ARG CI DATABASE_URL KALSHI_API_KEY_ID KALSHI_PRIVATE_KEY NATURAL_AGENT_ID NATURAL_API_KEY NATURAL_PER_TX_LIMIT_CENTS NIXPACKS_METADATA NIXPACKS_NODE_VERSION NODE_ENV NPM_CONFIG_PRODUCTION OPENAI_API_KEY OPENAI_MODEL RAILWAY_ENVIRONMENT RAILWAY_ENVIRONMENT_ID RAILWAY_ENVIRONMENT_NAME RAILWAY_PRIVATE_DOMAIN RAILWAY_PROJECT_ID RAILWAY_PROJECT_NAME RAILWAY_PUBLIC_DOMAIN RAILWAY_SERVICE_ID RAILWAY_SERVICE_NAME RAILWAY_SERVICE_NATURAL_MARKETS_URL RAILWAY_STATIC_URL RAILWAY_VOLUME_ID RAILWAY_VOLUME_MOUNT_PATH RAILWAY_VOLUME_NAME RESOLVE_INTERVAL_MS SLACK_APP_TOKEN SLACK_BOT_TOKEN STORE_PATH
ENV CI=$CI DATABASE_URL=$DATABASE_URL KALSHI_API_KEY_ID=$KALSHI_API_KEY_ID KALSHI_PRIVATE_KEY=$KALSHI_PRIVATE_KEY NATURAL_AGENT_ID=$NATURAL_AGENT_ID NATURAL_API_KEY=$NATURAL_API_KEY NATURAL_PER_TX_LIMIT_CENTS=$NATURAL_PER_TX_LIMIT_CENTS NIXPACKS_METADATA=$NIXPACKS_METADATA NIXPACKS_NODE_VERSION=$NIXPACKS_NODE_VERSION NODE_ENV=$NODE_ENV NPM_CONFIG_PRODUCTION=$NPM_CONFIG_PRODUCTION OPENAI_API_KEY=$OPENAI_API_KEY OPENAI_MODEL=$OPENAI_MODEL RAILWAY_ENVIRONMENT=$RAILWAY_ENVIRONMENT RAILWAY_ENVIRONMENT_ID=$RAILWAY_ENVIRONMENT_ID RAILWAY_ENVIRONMENT_NAME=$RAILWAY_ENVIRONMENT_NAME RAILWAY_PRIVATE_DOMAIN=$RAILWAY_PRIVATE_DOMAIN RAILWAY_PROJECT_ID=$RAILWAY_PROJECT_ID RAILWAY_PROJECT_NAME=$RAILWAY_PROJECT_NAME RAILWAY_PUBLIC_DOMAIN=$RAILWAY_PUBLIC_DOMAIN RAILWAY_SERVICE_ID=$RAILWAY_SERVICE_ID RAILWAY_SERVICE_NAME=$RAILWAY_SERVICE_NAME RAILWAY_SERVICE_NATURAL_MARKETS_URL=$RAILWAY_SERVICE_NATURAL_MARKETS_URL RAILWAY_STATIC_URL=$RAILWAY_STATIC_URL RAILWAY_VOLUME_ID=$RAILWAY_VOLUME_ID RAILWAY_VOLUME_MOUNT_PATH=$RAILWAY_VOLUME_MOUNT_PATH RAILWAY_VOLUME_NAME=$RAILWAY_VOLUME_NAME RESOLVE_INTERVAL_MS=$RESOLVE_INTERVAL_MS SLACK_APP_TOKEN=$SLACK_APP_TOKEN SLACK_BOT_TOKEN=$SLACK_BOT_TOKEN STORE_PATH=$STORE_PATH

# setup phase
# noop

# install phase
ENV NIXPACKS_PATH=/app/node_modules/.bin:$NIXPACKS_PATH
COPY . /app/.
RUN --mount=type=cache,id=s/0fcc195f-3bb6-4d62-ad03-7dbab720acde-/root/npm,target=/root/.npm npm ci

# build phase
COPY . /app/.
RUN --mount=type=cache,id=s/0fcc195f-3bb6-4d62-ad03-7dbab720acde-next/cache,target=/app/.next/cache --mount=type=cache,id=s/0fcc195f-3bb6-4d62-ad03-7dbab720acde-node_modules/cache,target=/app/node_modules/.cache npm run build


RUN printf '\nPATH=/app/node_modules/.bin:$PATH' >> /root/.profile


# start
COPY . /app

CMD ["npm start"]

